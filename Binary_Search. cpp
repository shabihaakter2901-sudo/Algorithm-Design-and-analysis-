#include <iostream>
using namespace std;

int main()
{
    int numbers[10] = {3, 7, 12, 23, 34, 45, 56, 67, 89, 90};

    int target;
    int foundIndex = -1;

    cout << "Enter an integer to search for: ";
    cin >> target;

    int left = 0;
    int right = 9;

    while (left <= right)
    {
        int mid = (left + right) / 2;

        if (numbers[mid] == target)
        {
            foundIndex = mid;
            break;
        }
        else if (target > numbers[mid])
        {
            left = mid + 1;
        }
        else if (target < numbers[mid])
        {
            right = mid - 1;
        }
    }

    if (foundIndex != -1)
    {
        cout << target << " was found at index "
             << foundIndex << endl;
    }
    else
    {
        cout << target << " was not found in the array." << endl;
    }

    return 0;
}
