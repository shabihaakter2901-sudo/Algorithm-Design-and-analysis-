#include <iostream>
using namespace std;

int main()
{
    int numbers[] = {7, 3, 9, 2, 8};
    int n = sizeof(numbers) / sizeof(numbers[0]);

    for (int i = 1; i < n; i++)
    {
        int key = numbers[i];
        int j = i - 1;

        while (j >= 0 && numbers[j] > key)
        {
            numbers[j + 1] = numbers[j];
            j--;
        }

        numbers[j + 1] = key;
    }

    cout << "Sorted array: ";

    for (int i = 0; i < n; i++)
    {
        cout << numbers[i] << " ";
    }

    return 0;
}
