#include <iostream>
using namespace std;

int main()
{
    int numbers[10] = {12, 45, 7, 23, 89, 34, 56, 90, 3, 67};

    int target;
    int foundIndex = -1;

    cout << "Enter an integer to search for: ";
    cin >> target;

    for (int i = 0; i < 10; i++)
    {
        if (numbers[i] == target)
        {
            foundIndex = i;
            break;
        }
    }

    if (foundIndex != -1)
    {
        cout << target << " was found at index " << foundIndex << endl;
    }
    else
    {
        cout << target << " was not found in the array " << endl;
    }

    return 0;
}
